// The first behaviour only some bodies have, and its control.
//
// Two bodies placed the same way, ten units out on either side of a player that
// never moves. One is granted `Seek` and the other is not — and the second is
// the point: a pass that walked *every* body would satisfy every assertion
// about the chaser, and only the bystander would notice. Composition is shown
// by what does not happen.
//
// SPEED is 3.5 units/sec and the budget is one second, so the chaser closes
// 3.5 units: 10.0 - 3.5 = 6.5. Still far outside the 0.55 stopping distance, so
// this is about steering alone, with no arrival clamp and no contact.
(
    description: "A body granted Seek closes on the player at the speed its constant claims; one without it never moves.",
    setup: (
        actions: [
            Place((10.0, 0.0)),
            Seek(0),
            Place((-10.0, 0.0)),
        ],
    ),
    inputs: [],
    budget: (ticks: 60),
    expect: (
        player_pos: (x: 0.0, z: 0.0, tol: 0.0001),
        contacts: 0,
        crowd_contacts: 0,
        enemy_count: 2,
        bodies: [
            (nth: 0, seeking: true,  pos: (x: 6.5,   z: 0.0, tol: 0.001)),
            (nth: 1, seeking: false, pos: (x: -10.0, z: 0.0, tol: 0.0001)),
        ],
    ),
)
