        ])),
        (at: 1, expect: (enemy_count: 2, encounters: [
            (scene: 1, encounter: 0, state: Some((phase: Running, defeated: 0, target: 1, remaining_ticks: 9))),
        ], source_states: [
            (scene: 2, source: 0, state: Some((enabled: true, countdown: 0, emitted: 1))),
        ])),
    ],
    budget: (ticks: 4),
