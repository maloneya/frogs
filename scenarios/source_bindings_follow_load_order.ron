    ),
    encounters: [(name: "Trial", start: Activated(0), objective: Defeat((sources: [0], count: 1, within_ticks: 10)))],
))),
        (at: 0, action: Load((engine: (name: "external source",
            sources: [(pos: (-20.0, 0.0), enabled: false)])))),
        (at: 3, action: Evict(1)),
    ],
    interactions: [0],
    source_switches: [(at: 1, scene: 2, source: 0, enabled: true)],
