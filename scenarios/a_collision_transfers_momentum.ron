// Touching unit masses are inside the contact slop, so the contact is rigid:
// the first substep's impulse J=6/2=3 leaves both at 3m/s (no restitution).
// Both travel 3/60m, then passive .9 drag leaves 2.7m/s. They only touch,
// so nothing counts as crowded; the pair exchanged momentum.
(description: "A carried body transfers momentum to its neighbour without an attack.",
 setup: (actions: [Place((10.0, 0.0)), Place((10.5, 0.0))]),
 impulses: [(at: 0, target: Placed(0), value: (6.0, 0.0))], budget: (ticks: 1),
 expect: (bodies: [
 (nth: 0, pos: (x: 10.05, z: 0.0, tol: 0.00001), velocity: (x: 2.7, z: 0.0, tol: 0.00001)),
 (nth: 1, pos: (x: 10.55, z: 0.0, tol: 0.00001), velocity: (x: 2.7, z: 0.0, tol: 0.00001))], trace: "a_collision_transfers_momentum.trace"))
