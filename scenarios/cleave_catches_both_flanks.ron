// A 1.1m disc sweeps from (-1.8,1.2) to (1.8,1.2) over six samples.
// The flanks are 1m beyond the endpoints; the centre at z=3.1 enters on
// sample 2. Impulse 6 / mass 1
// yields 6m/s, then a .1m first step and 5.4m/s after damping.
(
    description: "Cleave reaches both flanks and the distant centre in order, with a single short impulse per body.",
    setup: (actions: [
        Place((-2.8, 1.2)), Place((0.0, 3.1)), Place((2.8, 1.2)),
        Place((0.0, -1.5)), Place((4.0, 1.2)),
    ]),
    attack_profiles: [(at: 0, profile: Cleave)],
    attacks: [0],
    checkpoints: [
        (at: 5, expect: (attack_phase: Startup, struck: 0)),
        (at: 6, expect: (hitbox: true, struck: 1, bodies: [
            (nth: 0, pos: (x: -2.8, z: 1.2, tol: 0.00001),
             velocity: (x: 0.0, z: 6.0, tol: 0.00001)),
        ])),
        (at: 7, expect: (struck: 1, bodies: [
            (nth: 0, pos: (x: -2.8, z: 1.3, tol: 0.00001),
             velocity: (x: 0.0, z: 5.4, tol: 0.00001)),
        ])),
        (at: 8, expect: (struck: 2, bodies: [
            (nth: 1, velocity: (x: 0.0, z: 6.0, tol: 0.00001)),
        ])),
        (at: 10, expect: (struck: 2)),
        (at: 11, expect: (hitbox: true, struck: 3, bodies: [
            (nth: 2, velocity: (x: 0.0, z: 6.0, tol: 0.00001)),
        ])),
        (at: 12, expect: (attack_phase: Recovery, bodies: [
            // Six, four and one integrations since the respective hits.
            (nth: 0, health: 1, pos: (x: -2.8, z: 1.668559, tol: 0.00001)),
            (nth: 1, health: 1, pos: (x: 0.0, z: 3.4439, tol: 0.00001)),
            (nth: 2, health: 1, pos: (x: 2.8, z: 1.3, tol: 0.00001)),
        ])),
    ],
    budget: (ticks: 23),
    expect: (
        attack_profile: Cleave, attack_phase: Idle, struck: 3,
        contacts: 0, crowd_contacts: 0, enemy_count: 5,
        bodies: [
            (nth: 3, health: 3, pos: (x: 0.0, z: -1.5, tol: 0.0)),
            (nth: 4, health: 3, pos: (x: 4.0, z: 1.2, tol: 0.0)),
        ],
        events: (
        kinds: [Swung, HitboxOpened, Hit, Impulsed, HitboxClosed],
        sequence: [
            (0, Swung),
            (6, HitboxOpened),
            (6, Hit(id: (1, 1), remaining: 1)),
            (6, Impulsed(id: (1, 1), value: (0.0000,6.0000), source: Some((0, 1)), tolerance: 0.00005)),
            (8, Hit(id: (2, 1), remaining: 1)),
            (8, Impulsed(id: (2, 1), value: (0.0000,6.0000), source: Some((0, 1)), tolerance: 0.00005)),
            (11, Hit(id: (3, 1), remaining: 1)),
            (11, Impulsed(id: (3, 1), value: (0.0000,6.0000), source: Some((0, 1)), tolerance: 0.00005)),
            (12, HitboxClosed),
        ],
    ),
    ),
)
