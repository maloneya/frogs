(
    description: "Lengthening during startup and shortening during recovery preserve the committed swing; the next attack starts on exactly startup + active + recovery.",
    attack_recovery: [
        (at: 0, recovery: 2),
        (at: 1, recovery: 30),
        (at: 27, recovery: 1),
    ],
    // First swing lasts 6+6+2=14 ticks. Second lasts 6+6+30=42.
    // Presses one tick before each boundary must be dropped, not buffered.
    attacks: [0, 13, 14, 55, 56, 68, 69],
    checkpoints: [
        (at: 1, expect: (attack_phase: Startup, swing_tick: 1, recovery_ticks: 30, swing_recovery_ticks: 2)),
        (at: 6, expect: (attack_phase: Active, hitbox: true)),
        (at: 13, expect: (attack_phase: Recovery, swing_tick: 13)),
        (at: 14, expect: (attack_phase: Startup, swing_tick: 0, swing_recovery_ticks: 30)),
        (at: 27, expect: (attack_phase: Recovery, swing_tick: 13, recovery_ticks: 1, swing_recovery_ticks: 30)),
        (at: 55, expect: (attack_phase: Recovery, swing_tick: 41)),
        (at: 56, expect: (attack_phase: Startup, swing_tick: 0, swing_recovery_ticks: 1)),
        (at: 68, expect: (attack_phase: Recovery, swing_tick: 12)),
        (at: 69, expect: (attack_phase: Startup, swing_tick: 0)),
    ],
    budget: (ticks: 83),
    expect: (
        attack_phase: Idle, swing_tick: 0, recovery_ticks: 1, swing_recovery_ticks: 0,
        events: (
        kinds: [AttackRecoveryChanged, Swung, HitboxOpened, HitboxClosed, Hit],
        sequence: [
            (0, AttackRecoveryChanged(recovery: 2)),
            (0, Swung),
            (1, AttackRecoveryChanged(recovery: 30)),
            (6, HitboxOpened),
            (12, HitboxClosed),
            (14, Swung),
            (20, HitboxOpened),
            (26, HitboxClosed),
            (27, AttackRecoveryChanged(recovery: 1)),
            (56, Swung),
            (62, HitboxOpened),
            (68, HitboxClosed),
            (69, Swung),
            (75, HitboxOpened),
            (81, HitboxClosed),
        ],
    ),
    ),
)
