// Stable identities #1/#2/#3 initially choose Run/Sprint/Walk. At 30m/s²,
// v[n+1] = min(desired, .9*v[n]+.5); position advances v[n+1]/60.
// Summing 24 steps gives .89858075, 1.25441835 and .57175 metres.
// Identity-derived boundaries change #1 to Sprint at tick 27 and #2 to Run at 30.
(
    description: "Three chasers accelerate into distinct gaits while an ungranted body stays still.",
    setup: (actions: [Place((20.0, 0.0)), Seek(0), Place((-20.0, 0.0)), Seek(1),
        Place((0.0, 20.0)), Seek(2), Place((0.0, -20.0))]),
    checkpoints: [
        (at: 0, expect: (bodies: [
            (nth: 0, gait: Run, velocity: (x: -0.5, z: 0.0, tol: 0.00001)),
            (nth: 1, gait: Sprint, velocity: (x: 0.5, z: 0.0, tol: 0.00001)),
            (nth: 2, gait: Walk, velocity: (x: 0.0, z: -0.5, tol: 0.00001)),
        ])),
        (at: 23, expect: (contacts: 0, crowd_contacts: 0, bodies: [
            (nth: 0, gait: Run, pos: (x: 19.10141925, z: 0.0, tol: 0.0001),
                velocity: (x: -2.5, z: 0.0, tol: 0.00001)),
            (nth: 1, gait: Sprint, pos: (x: -18.74558165, z: 0.0, tol: 0.0001),
                velocity: (x: 4.0, z: 0.0, tol: 0.00001)),
            (nth: 2, gait: Walk, pos: (x: 0.0, z: 19.42825, tol: 0.0001),
                velocity: (x: 0.0, z: -1.5, tol: 0.00001)),
            (nth: 3, seeking: false, pos: (x: 0.0, z: -20.0, tol: 0.0)),
        ])),
    ],
    budget: (ticks: 31),
    expect: (contacts: 0, crowd_contacts: 0, bodies: [
        (nth: 0, gait: Sprint),
        (nth: 1, gait: Run, velocity: (x: 3.1, z: 0.0, tol: 0.00001)),
        (nth: 2, gait: Walk),
    ], events: (kinds: [GaitsChanged], sequence: [
        (27, GaitsChanged(walking: 0, running: 0, sprinting: 1)),
        (30, GaitsChanged(walking: 0, running: 1, sprinting: 0)),
    ])),
)
