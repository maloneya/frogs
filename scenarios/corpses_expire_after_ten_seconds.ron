// Beam pulses on 0, 12, 24: death on 24 with v=1.5*(1-.9^25).
// The corpse starts on that lethal tick; physics settles on tick 93.
// The corpse still exists on 623, then expires on 624. Walking through it
// after death must not generate contact or change the predicted distance.
// Forty motor steps, each tick's change ramped over four substeps (a tick
// covers (v + 5/8 change) * dt), sum to 4.95787848m.
(
    description: "Defeat leaves noncolliding remains for exactly ten seconds.",
    setup: (actions: [Place((0.0, 3.0))]),
    attack_profiles: [(at: 0, profile: Disintegrate)],
    channels: [(at: 0, ticks: 25)],
    inputs: [(at: 94, ticks: 40, dir: (0.0, 1.0))],
    checkpoints: [
        (at: 23, expect: (enemy_count: 1, corpse_count: 0)),
        (at: 24, expect: (enemy_count: 0, corpse_count: 1, bodies: [(nth: 0, alive: true, health: 0)])),
        (at: 25, expect: (corpse_count: 1, bodies: [(nth: 0, alive: true, health: 0)])),
        (at: 92, expect: (corpse_count: 1, bodies: [(nth: 0, alive: true, health: 0)])),
        (at: 93, expect: (corpse_count: 1, bodies: [(nth: 0, alive: false)])),
        (at: 133, expect: (corpse_count: 1, contacts: 0, player_pos: (x: 0.0, z: 4.9578785, tol: 0.001))),
        (at: 623, expect: (corpse_count: 1)),
        (at: 624, expect: (corpse_count: 0)),
    ],
    budget: (ticks: 625),
    expect: (enemy_count: 0, corpse_count: 0, contacts: 0),
)
