// What `EntityId` is for, stated as a prediction.
//
// Two separate things are being asserted, and only the second one is hard.
//
// **The swap.** The horde is stored densely, so removing a body moves the last
// one into the hole. Body 2's row goes from index 2 to index 1 without anything
// touching body 2, and its name has to follow.
//
// **The reuse.** The freed slot is handed straight back out to the next
// placement — that is what the trailing `Place` is for, and it is the only way
// the interesting failure is reachable at all. Once slot 1 has a live occupant
// again, the retired name for its *previous* occupant either resolves to the
// newcomer or it does not, and that is precisely what a generation decides.
//
// Without the reuse this file is much weaker than it looks: an earlier version
// stopped at the despawn, and it passed with the generation bump deleted. A
// vacated slot is caught by the vacancy sentinel whether or not generations
// work, so despawn alone tests the sentinel and nothing else.
//
// The bodies are 2.0 apart, far more than the 0.5 two of them will need once
// they collide with each other. That is on purpose: this scenario is about
// names, and spacing it now means enemy-enemy separation cannot quietly turn it
// into a scenario about the solver.
(
    description: "A retired name stays dead even after its slot is handed to somebody else.",
    setup: (
        actions: [
            Place((10.0, 0.0)),   // 0
            Place((12.0, 0.0)),   // 1
            Place((14.0, 0.0)),   // 2
            Despawn(1),           // frees slot 1; body 2's row swaps down into it
            Place((16.0, 0.0)),   // 3 — takes the slot body 1 used to own
        ],
    ),
    // No input at all. Nothing here is a claim about movement: every body is
    // far outside the player's 0.55 contact distance and far inside the arena,
    // so anything that moves is a bug rather than a prediction gone wrong.
    inputs: [],
    budget: (ticks: 10),
    expect: (
        player_pos: (x: 0.0, z: 0.0, tol: 0.0001),
        contacts: 0,
        enemy_count: 3,
        bodies: [
            (nth: 0, alive: true,  pos: (x: 10.0, z: 0.0, tol: 0.0001)),
            // The whole point. This name's slot is live again, owned by
            // placement 3 — and this name must still resolve to nothing.
            (nth: 1, alive: false),
            (nth: 2, alive: true,  pos: (x: 14.0, z: 0.0, tol: 0.0001)),
            (nth: 3, alive: true,  pos: (x: 16.0, z: 0.0, tol: 0.0001)),
        ],
    ),
)
