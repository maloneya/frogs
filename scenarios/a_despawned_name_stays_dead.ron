// What `EntityId` is for. See `crate::slots` for the generational-index
// argument; this is it driven through the simulation.
//
// Two things are asserted, and only the second is hard. **The swap:** removing
// a body moves the last one into its row, and body 2's name has to follow.
// **The reuse:** the trailing `Place` hands the freed slot to somebody else,
// which is the only way the interesting failure is reachable at all. An earlier
// version stopped at the despawn and passed with the generation bump deleted —
// a vacated slot is caught by the vacancy sentinel either way.
//
// Bodies 2.0 apart, far more than the 0.5 they would need, so enemy-enemy
// separation cannot quietly turn this into a scenario about the solver.
(
    description: "A retired name stays dead even after its slot is handed to somebody else.",
    setup: (
        actions: [
            Place((10.0, 0.0)),   // 0
            Place((12.0, 0.0)),   // 1
            Place((14.0, 0.0)),   // 2
            Despawn(1),           // frees slot 1; body 2's row swaps down into it
            Place((16.0, 0.0)),   // 3 — takes the slot body 1 used to own
        ],
    ),
    // No input at all. Nothing here is a claim about movement: every body is
    // far outside the player's 0.55 contact distance and far inside the arena,
    // so anything that moves is a bug rather than a prediction gone wrong.
    inputs: [],
    budget: (ticks: 10),
    expect: (
        player_pos: (x: 0.0, z: 0.0, tol: 0.0001),
        contacts: 0,
        enemy_count: 3,
        bodies: [
            (nth: 0, alive: true,  pos: (x: 10.0, z: 0.0, tol: 0.0001)),
            // The whole point. This name's slot is live again, owned by
            // placement 3 — and this name must still resolve to nothing.
            (nth: 1, alive: false),
            (nth: 2, alive: true,  pos: (x: 14.0, z: 0.0, tol: 0.0001)),
            (nth: 3, alive: true,  pos: (x: 16.0, z: 0.0, tol: 0.0001)),
        ],
    ),
)
