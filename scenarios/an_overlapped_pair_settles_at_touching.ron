// The crowd solver at the level of one pair, predicted by hand.
//
// Two bodies 0.3 apart. Enemy contact distance is 2 * ENEMY_RADIUS = 0.5, so
// they start 0.2 overlapped. Equal masses, so the correction splits evenly and
// each moves 0.1:
//
//   3.0 - 0.1 = 2.9
//   3.3 + 0.1 = 3.4        gap 0.5, exactly touching
//
// Then nothing. That second half is the part worth asserting: `crowd_contacts`
// is 0 on the final tick, which says the pair separated *and stopped*. Exactly
// touching must not count as overlapping, or a settled crowd would jitter
// forever — every pair re-contacting every tick, each one emitting a trace
// event, at a cost that rises with the square of the horde.
//
// Placed at x=3 with the player at the origin and no input, so the player's own
// contact distance of 0.55 is nowhere near: this is a prediction about the
// crowd solver alone.
(
    description: "Two overlapping bodies push apart to exactly touching, then stop.",
    setup: (
        actions: [
            Place((3.0, 0.0)),
            Place((3.3, 0.0)),
        ],
    ),
    inputs: [],
    budget: (ticks: 10),
    expect: (
        contacts: 0,
        crowd_contacts: 0,
        bodies: [
            (nth: 0, pos: (x: 2.9, z: 0.0, tol: 0.0001)),
            (nth: 1, pos: (x: 3.4, z: 0.0, tol: 0.0001)),
        ],
        trace: "an_overlapped_pair_settles_at_touching.trace",
    ),
)
