// The crowd solver at one pair. Two bodies 0.3 apart against a 0.5 contact
// distance are 0.2 overlapped; equal masses split it evenly, so each moves 0.1
// to 2.9 and 3.4 — exactly touching.
//
// Then nothing, and that is the half worth asserting: `crowd_contacts: 0` on
// the final tick says the pair separated *and stopped*. Exactly touching must
// not count as overlapping, or a settled crowd jitters forever — see `SLOP` in
// `crate::contact`.
//
// Placed at x=3 with the player at the origin and no input, so the player's own
// 0.55 is nowhere near: this is the crowd solver alone.
(
    description: "Two overlapping bodies push apart to exactly touching, then stop.",
    setup: (
        actions: [
            Place((3.0, 0.0)),
            Place((3.3, 0.0)),
        ],
    ),
    inputs: [],
    budget: (ticks: 10),
    expect: (
        contacts: 0,
        crowd_contacts: 0,
        bodies: [
            (nth: 0, pos: (x: 2.9, z: 0.0, tol: 0.0001)),
            (nth: 1, pos: (x: 3.4, z: 0.0, tol: 0.0001)),
        ],
        trace: "an_overlapped_pair_settles_at_touching.trace",
    ),
)
