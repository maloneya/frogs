// Sources start ready, and each queues one seeking body on every tick.
// No attacks or other deaths: population after tick t is 64 * (t+1).
// This short ramp stays within the trace history needed for spawn identities.
(
    description: "The live flood file emits 64 seekers every tick, reaching 4,096 in 64 ticks, with deterministic crowd motion.",
    setup: (scenes: [File("../scenes/stress_spawn_flood.ron")]),
    checkpoints: [
        (at: 0, expect: (enemy_count: 64, seekers: 64, sources: 64, scene_count: 1)),
        (at: 15, expect: (enemy_count: 1024, seekers: 1024)),
        (at: 31, expect: (enemy_count: 2048, seekers: 2048)),
    ],
    budget: (ticks: 64),
    expect: (enemy_count: 4096, seekers: 4096, sources: 64, scene_count: 1),
)
