// Motor v=min(speed,.9*v+1); each tick's change ramps in over four substeps,
// so a tick covers (v + 5/8 change) * dt. Speed 9, then 3 from tick 6, then 0.
(
    description: "Speed changes alter the motor target before their tick; acceleration and braking remain bounded.",
    inputs: [(at: 0, ticks: 18, dir: (1.0, 0.0))],
    tuning: [
        (at: 6, values: { PlayerSpeed: 3.0, PlayerAcceleration: 60.0, PlayerMass: 20.0, CleaveImpulse: 6.0, SlamImpulse: 72.0, ContactFrequency: 30.0, ContactDamping: 10.0, ContactPushSpeed: 3.0 }),
        (at: 12, values: { PlayerSpeed: 0.0, PlayerAcceleration: 60.0, PlayerMass: 20.0, CleaveImpulse: 6.0, SlamImpulse: 72.0, ContactFrequency: 30.0, ContactDamping: 10.0, ContactPushSpeed: 3.0 }),
    ],
    checkpoints: [
        (at: 5, expect: (player_pos: (x: 0.2678766, z: 0.0, tol: 0.00001))),
        (at: 6, expect: (player_pos: (x: 0.33067224, z: 0.0, tol: 0.00001))),
        (at: 11, expect: (player_pos: (x: 0.5820287, z: 0.0, tol: 0.00001))),
        (at: 12, expect: (player_pos: (x: 0.6184870, z: 0.0, tol: 0.00001))),
    ],
    budget: (ticks: 18),
    expect: (player_pos: (x: 0.63794535, z: 0.0, tol: 0.00001),
        gameplay_events: (
            kinds: [TuningChanged],
            sequence: [
                (6, TuningChanged(field: PlayerSpeed, value: 3.0)),
