    description: "Independent aim allows retreating strikes and is committed through recovery, including dropped attack presses.",
    setup: (actions: [Place((-2.8, 0.15)), Place((-2.8, -4.5))]),
    inputs: [(at: 0, ticks: 23, dir: (0.0, -1.0))],
    aims: [(at: 0, dir: (0.0, 1.0)), (at: 1, dir: (1.0, 0.0))],
    attacks: [0, 5, 22],
    checkpoints: [
        (at: 0, expect: (facing: (value: 0.0, tol: 0.00001), player_pos: (x: 0.0, z: -0.01041667, tol: 0.00001))),
        (at: 5, expect: (hitbox: false, struck: 0, facing: (value: 0.0, tol: 0.00001))),
        (at: 6, expect: (hitbox: true, struck: 1,
            player_pos: (x: 0.0, z: -0.3515056, tol: 0.00001),
            bodies: [(nth: 0, health: 1, velocity: (x: 0.0, z: 6.0, tol: 0.00001)), (nth: 1, health: 3)])),
        (at: 12, expect: (attack_phase: Recovery, facing: (value: 0.0, tol: 0.00001))),
        (at: 21, expect: (attack_phase: Recovery, facing: (value: 0.0, tol: 0.00001))),
    ],
    budget: (ticks: 23),
