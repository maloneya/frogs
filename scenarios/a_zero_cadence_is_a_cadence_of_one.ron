// Source::try_from normalizes a zero cadence to one tick for every caller,
// including authored scenarios and harness commands.
//
// Three ticks, a cadence of one, and a source that starts ready: three bodies.
// The ring is wide enough that they never touch, so `crowd_contacts: 0` is the
// control on the count meaning what it says.
(
    description: "A source written with a cadence of zero fires on every tick, rather than underflowing.",
    setup: (
        sources: [
            (pos: (30.0, 0.0), radius: 3.0, every: 0),
        ],
    ),
    inputs: [],
    budget: (ticks: 3),
    expect: (
        player_pos: (x: 0.0, z: 0.0, tol: 0.0001),
        enemy_count: 3,
        seekers: 0,
        sources: 1,
        contacts: 0,
        crowd_contacts: 0,
    ),
)
