// A source that fires when the player comes close, and not before.
//
// The bounded motor reaches 9m/s on its 22nd tick; each tick's whole change
// ramps in over four substeps. After 40 ticks it has covered 4.95787848m;
// after 41 ticks, 5.10787848m. The gate reads the prior completed position,
// so the ready source first fires at tick 41.
// A 60-tick cadence against a 45-tick budget proves that waiting outside
// the radius preserves readiness rather than consuming a missed firing.
(
    description: "A proximity source fires on the exact tick the player crosses its radius, having waited ready since tick 0.",
    setup: (
        sources: [
            (pos: (10.0, 0.0), every: 60, when: PlayerWithin(5.0), what: (physical: (health: Some(3), character: true), role: Hostile)),
        ],
    ),
    inputs: [
        (at: 0, ticks: 45, dir: (1.0, 0.0)),
    ],
    budget: (ticks: 45),
    expect: (
        player_pos: (x: 5.7078785, z: 0.0, tol: 0.001),
        enemy_count: 1,
        sources: 1,
        contacts: 0,
        bodies: [
            (nth: 0, action: Idle, pos: (x: 10.0, z: 0.0, tol: 0.0001)),
        ],
        events: (
        kinds: [Fired, Placed, Refused],
        sequence: [
            (41, Fired(source: "s0")),
            (41, Placed(id: (1, 1))),
        ],
    ),
    ),
)
