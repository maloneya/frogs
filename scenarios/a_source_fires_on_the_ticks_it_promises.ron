// A source at a stated cadence puts bodies in on the ticks it promises.
//
// The exact Fired/Placed event sequence predicts ticks 0, 10, 20 and 30;
// enemy_count alone cannot establish cadence. Refused events must be absent.
// Fired names the producer; Placed identifies the body admitted from its request.
// The source carries a pursuing actor definition; this case checks birth cadence.
// At 2.5 m/s and thirty metres away, none reaches the player within this budget.

(
    description: "A source at every=10 fires on ticks 0, 10, 20 and 30, and what it makes chases.",
    setup: (
        sources: [
            (pos: (30.0, 0.0), radius: 3.0, every: 10, what: (physical: (health: Some(3), character: true), role: Hostile, actions: [Move((destination: Target(Player), speed: 2.5, acceleration: 30.0, stop_distance: 0.55))], behavior: Action(0))),
        ],
    ),
    inputs: [],
    budget: (ticks: 31),
    expect: (
        player_pos: (x: 0.0, z: 0.0, tol: 0.0001),
        enemy_count: 4,
        sources: 1,
        contacts: 0,
        crowd_contacts: 0,
        events: (
        kinds: [Fired, Placed, Refused],
        sequence: [
            (0, Fired(source: "s0")),
            (0, Placed(id: (1, 1))),
            (10, Fired(source: "s0")),
            (10, Placed(id: (2, 1))),
            (20, Fired(source: "s0")),
            (20, Placed(id: (3, 1))),
            (30, Fired(source: "s0")),
            (30, Placed(id: (4, 1))),
        ],
    ),
    ),
)
