// The crowd solver in the configuration the game actually has.
//
// It exists because of a surprise: `shoving_through_the_horde` walks due +X
// through the same 64 bodies and produces **zero** crowd contacts — its golden
// trace did not change by a line when enemy-enemy separation landed. The horde
// spawns on an axis-aligned grid 0.7 apart against a 0.5 contact distance, so
// pushing along an axis slides bodies down the corridors between rows and never
// closes the 0.2 of slack. Push across the grid and 20 of 60 ticks report
// contacts.
//
// The lesson is about the test, not the solver: a horde laid out on a grid has
// an axis you can travel along and see nothing.
(
    description: "Shoved across its own grid the horde compresses, where shoved along it, it does not.",
    setup: (scenes: [(engine: (name: "shoving_diagonally_jostles_the_crowd", grids: [(origin: (-2.45, -2.45), columns: 8, rows: 8, spacing: 0.7, what: (physical: (health: Some(3), character: true), role: Hostile))]))]),
    inputs: [
        // Normalised on the way in, so this is a full-speed diagonal rather
        // than root-two times the speed.
        (at: 0, ticks: 60, dir: (1.0, -1.0)),
    ],
    budget: (ticks: 60),
    expect: (
        enemy_count: 64,
        events: (
        kinds: [Contacts, Crowded],
        sequence: [
            (0, Contacts(count: 3)),
            (1, Contacts(count: 1)),
            (2, Contacts(count: 1)),
            (3, Crowded(count: 2)),
            (3, Contacts(count: 1)),
            (4, Crowded(count: 1)),
            (4, Contacts(count: 1)),
            (5, Crowded(count: 1)),
            (5, Contacts(count: 3)),
            (6, Crowded(count: 1)),
            (6, Contacts(count: 3)),
            (7, Crowded(count: 1)),
            (7, Contacts(count: 1)),
            (8, Crowded(count: 2)),
            (8, Contacts(count: 1)),
            (9, Crowded(count: 4)),
            (9, Contacts(count: 1)),
            (10, Crowded(count: 3)),
            (10, Contacts(count: 2)),
            (11, Crowded(count: 3)),
            (11, Contacts(count: 2)),
            (12, Crowded(count: 4)),
            (12, Contacts(count: 1)),
            (13, Crowded(count: 4)),
            (13, Contacts(count: 1)),
            (14, Crowded(count: 3)),
            (14, Contacts(count: 1)),
            (15, Crowded(count: 2)),
            (15, Contacts(count: 2)),
            (16, Crowded(count: 2)),
            (16, Contacts(count: 2)),
            (17, Crowded(count: 3)),
            (17, Contacts(count: 2)),
            (18, Crowded(count: 3)),
            (18, Contacts(count: 2)),
            (19, Crowded(count: 4)),
            (19, Contacts(count: 2)),
            (20, Crowded(count: 2)),
            (20, Contacts(count: 2)),
            (21, Crowded(count: 1)),
            (21, Contacts(count: 3)),
            (22, Contacts(count: 2)),
            (23, Contacts(count: 2)),
            (24, Crowded(count: 1)),
            (24, Contacts(count: 1)),
            (25, Contacts(count: 1)),
            (26, Contacts(count: 1)),
            (27, Contacts(count: 1)),
            (28, Contacts(count: 1)),
            (29, Contacts(count: 1)),
            (30, Contacts(count: 1)),
        ],
    ),
    ),
)
