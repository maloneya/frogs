// The scene authors all 16,384 bodies as one `grids` entry, so the corner
// checks below are also the assertion that expansion covers the whole 128x128
// rectangle: nth 0 is the origin and nth 16383 is 127 columns and 127 rows out.
// Row-major order is what the struck body numbers depend on.
//
// With no inputs and .7m spacing > .5m contact distance, every body stays
// put. Crowd breaker's first disc at (0,1.6) has 1.4m radius + .25m bodies.
// It catches x=+/- .35 and +/- 1.05 in the first three ranks (z=1.2,1.9,2.6):
// even the furthest has sqrt(1.05^2+1^2) < 1.65. The fourth rank at z=3.3
// lies outside. Use only the first active tick to avoid
// turning later dense-contact outcomes into hand-copied golden numbers.
(
    description: "16,384 static bodies expanded from one grid stay still until Crowd breaker strikes twelve across three ranks; the full world replays.",
    setup: (scenes: [File("../scenes/stress_static_16384.ron")]),
    attack_profiles: [(at: 0, profile: CrowdBreaker)],
    attacks: [8],
    checkpoints: [
        (at: 7, expect: (
            scene_count: 1, enemy_count: 16384, seekers: 0, sources: 0,
            contacts: 0, crowd_contacts: 0,
            player_pos: (x: 0.0, z: 0.0, tol: 0.0),
            bodies: [
                (nth: 0, pos: (x: -44.45, z: 1.2, tol: 0.00001)),
                (nth: 16383, pos: (x: 44.45, z: 90.1, tol: 0.00001)),
            ],
        )),
    ],
    budget: (ticks: 18),
    expect: (
        enemy_count: 16384, hitbox: true, struck: 12,
        bodies: [
            (nth: 63, health: 2, velocity: (x: 0.0, z: 40.0, tol: 0.00001)),
            (nth: 64, health: 2, velocity: (x: 0.0, z: 40.0, tol: 0.00001)),
            (nth: 319, health: 2), (nth: 320, health: 2),
            (nth: 447, health: 3), (nth: 448, health: 3),
        ],
    ),
)
