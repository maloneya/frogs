// Two kinds of enemy, from one description, behaving differently.
//
// **The difference is in the template and nowhere else.** Both bodies are asked
// for through the same door, on the same tick, ten units out on either side of
// a player that never moves; the only thing that differs is the list of
// behaviours the template names. The bystander is the control: a drain that
// granted every behaviour to everybody, or a pass that walked every body, would
// satisfy every assertion about the chaser and only fail here.
//
// SPEED is 3.5 units/sec and the budget is one second, so the chaser closes
// 3.5 units: 10.0 - 3.5 = 6.5. Still far outside the 0.55 stopping distance, so
// no arrival clamp and no contact is involved.
(
    description: "One description places a chaser and a bystander; only the chaser moves.",
    setup: (),
    inputs: [],
    spawns: [
        (at: 0, pos: (10.0, 0.0), what: (seeks: true)),
        (at: 0, pos: (-10.0, 0.0)),
    ],
    budget: (ticks: 60),
    expect: (
        player_pos: (x: 0.0, z: 0.0, tol: 0.0001),
        enemy_count: 2,
        seekers: 1,
        contacts: 0,
        crowd_contacts: 0,
        bodies: [
            (nth: 0, seeking: true,  pos: (x: 6.5,   z: 0.0, tol: 0.001)),
            (nth: 1, seeking: false, pos: (x: -10.0, z: 0.0, tol: 0.0001)),
        ],
        trace: "two_kinds_of_enemy_from_one_description.trace",
    ),
)
