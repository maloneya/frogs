// One body at a known spot makes the contact solver arithmetic.
//
// Predicted from the constants, not read back. Contact distance is
// PLAYER_RADIUS + ENEMY_RADIUS = 0.55, a tick of walking is 0.15, and the
// 0.05:1.0 mass split gives the player 1/21 of each correction.
//
// Ticks 1-16 are free travel. Tick 17 makes contact and separation corrects the
// overlap **in full** — the load-bearing detail, since a solver correcting a
// fraction per tick would leave a gap that drifts — so the gap is exactly 0.55
// from then on and both bodies advance 0.15 * 20/21 per tick:
//
//   player  2.5452381 + 13 * 0.1428571 = 4.4023810
//   body    3.0952381 + 13 * 0.1428571 = 4.9523810
//
// The tolerance is a hundred and fiftieth of a tick's walk: wide enough for f32
// accumulation, far too narrow to hide a one-tick error.
(
    description: "A body placed in the player's path is shoved exactly as far as the mass split says.",
    setup: (
        actions: [
            Place((3.0, 0.0)),
        ],
    ),
    inputs: [
        (at: 0, ticks: 30, dir: (1.0, 0.0)),
    ],
    budget: (ticks: 30),
    expect: (
        player_pos: (x: 4.4023810, z: 0.0, tol: 0.001),
        contacts: 1,
        enemy_count: 1,
        bodies: [
            (nth: 0, alive: true, pos: (x: 4.9523810, z: 0.0, tol: 0.001)),
        ],
    ),
)
