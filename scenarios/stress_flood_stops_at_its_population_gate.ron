// Seed just below the flood threshold through the ordinary grid door. This
// verifies the same file's full-population gate without a 512-tick warm-up or
// overflowing the scenario runner's placement-event history.
// First tick: 32,704 + 64 = 32,768. Subsequent ticks: every source is gated.
(
    description: "All 64 flood sources stop at 32,768 enemies, preserving the population instead of growing without bound.",
    setup: (enemies: 32704),
    scenes: [(at: 0, action: Load(File("../scenes/stress_spawn_flood.ron")))],
    checkpoints: [
        (at: 0, expect: (enemy_count: 32768, seekers: 64, sources: 64)),
    ],
    budget: (ticks: 3),
    expect: (enemy_count: 32768, seekers: 64, sources: 64, scene_count: 1),
)
