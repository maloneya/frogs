// Cleave stays committed for 22 ticks; selecting Slam at tick 1 applies at 22.
// A target 4.3m ahead is beyond Cleave's maximum reach, but enters Slam's
// final sample at 22+13=35, receiving exactly 40 impulse.
(
    description: "Selecting Slam during Cleave preserves the committed timing and geometry until the next swing.",
    setup: (actions: [Place((0.0, 4.3))]),
    attack_profiles: [(at: 1, profile: Slam)],
    attacks: [0, 22],
    checkpoints: [
        (at: 1, expect: (attack_phase: Startup, swing_tick: 1,
            attack_profile: Slam, swing_profile: Cleave,
            recovery_ticks: 16, swing_recovery_ticks: 10)),
        (at: 6, expect: (attack_phase: Active, struck: 0)),
        (at: 11, expect: (attack_phase: Active, struck: 0)),
        (at: 12, expect: (attack_phase: Recovery, hitbox: false)),
        (at: 22, expect: (attack_phase: Startup, swing_tick: 0,
            attack_profile: Slam, swing_profile: Slam, swing_recovery_ticks: 16)),
        (at: 30, expect: (attack_phase: Startup)),
        (at: 31, expect: (attack_phase: Active, struck: 0)),
        (at: 35, expect: (attack_phase: Active, struck: 1, bodies: [
            (nth: 0, health: 2, velocity: (x: 0.0, z: 40.0, tol: 0.00001)),
        ])),
    ],
    budget: (ticks: 37),
    expect: (attack_phase: Recovery, swing_tick: 14, struck: 1,
        attack_profile: Slam, swing_profile: Slam,
        trace: "attack_profiles_apply_to_the_next_swing.trace"),
)
