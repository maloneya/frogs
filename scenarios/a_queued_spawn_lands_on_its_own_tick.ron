// The spawn receipt identifies each request; exact Placed events assert latency.
// A seeker and a bystander in one batch also prove template grants stay distinct.
// Movement on the first tick is checked numerically by the scenario CLI checkpoint
// test and gait scenarios, so this fixture does not depend on chase-speed tuning.
(
    description: "Mixed templates requested at tick 10 appear on that tick with their own capabilities.",
    spawns: [
        (at: 10, pos: (10.0, 0.0), what: (seeks: true)),
        (at: 10, pos: (-10.0, 0.0)),
    ],
    checkpoints: [(at: 9, expect: (enemy_count: 0, seekers: 0))],
    budget: (ticks: 11),
    expect: (
        enemy_count: 2,
        seekers: 1,
        contacts: 0,
        crowd_contacts: 0,
        bodies: [
            (nth: 0, alive: true, seeking: true),
            (nth: 1, alive: true, seeking: false, pos: (x: -10.0, z: 0.0, tol: 0.0)),
        ],
        events: (
            kinds: [Placed, Refused, Fired],
            sequence: [(10, Placed(id: (1, 1))), (10, Placed(id: (2, 1)))],
        ),
    ),
)
