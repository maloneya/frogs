    source_switches: [(at: 4, source: 0, enabled: true)],
    inputs: [(at: 0, ticks: 22, dir: (1.0, 0.0))],
    checkpoints: [
        (at: 3, expect: (enemy_count: 0, source_states: [
            (source: 0, state: (enabled: false, countdown: 0, emitted: 0)),
        ])),
        (at: 4, expect: (enemy_count: 0, source_states: [
            (source: 0, state: (enabled: true, countdown: 0, emitted: 0)),
        ])),
        (at: 20, expect: (player_pos: (x: 2.1084672, z: 0.0, tol: 0.0001), enemy_count: 0, source_states: [
            (source: 0, state: (enabled: true, countdown: 0, emitted: 0)),
        ])),
    ],
    budget: (ticks: 22),
