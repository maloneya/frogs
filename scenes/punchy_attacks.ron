// Compare how much of a three-rank crowd one swing reaches and pushes.
// F2: start this file, then F1: choose Basic, Cleave or Crowd breaker.
// Close F1 and press Space without moving; watch coverage and the shove
// propagating into the rear ranks. Restart via F2 and reselect the profile
// for each comparison: a fresh scene resets attack tuning to Basic.
// Stationary bodies keep the same setup while you choose in the live menu.
(
    name: "Punchy attacks - three crowd ranks",
    bodies: [
        (pos: (-2.4, 1.2)), (pos: (-1.2, 1.2)), (pos: (0.0, 1.2)),
        (pos: (1.2, 1.2)), (pos: (2.4, 1.2)),
        (pos: (-2.4, 2.4)), (pos: (-1.2, 2.4)), (pos: (0.0, 2.4)),
        (pos: (1.2, 2.4)), (pos: (2.4, 2.4)),
        (pos: (-2.4, 3.6)), (pos: (-1.2, 3.6)), (pos: (0.0, 3.6)),
        (pos: (1.2, 3.6)), (pos: (2.4, 3.6)),
    ],
)
