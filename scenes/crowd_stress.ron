// Performance trial: 10,000 pursuing actors compress around the player. Stand still
// for 15 seconds, then reset perf and measure. Repeat while moving and swinging;
// watch enemy counts because defeating bodies reduces collision workload.
(
    scene: (
        engine: (
            name: "Crowd stress — 10,000 pursuing actors",
            grids: [(
                origin: (-34.65, -34.65), columns: 100, rows: 100, spacing: 0.7,
                what: (physical: (health: Some(3), character: true), role: Hostile, actions: [Move((destination: Target(Player), speed: 2.5, acceleration: 30.0, stop_distance: 0.55))], behavior: Action(0)),
            )],
        ),
    ),
)
