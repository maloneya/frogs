// Press F4 while standing in the torch pool: a brief cold flash reveals the
// stationary crowd beyond its eight-metre radius. Judge how much you register
// before darkness returns. F4 restarts the same moment; F2 restarts the scene.
(
    engine: (
        name: "Storm: reveal the horde",
        grids: [(
            origin: (-4.0, -13.0), columns: 13, rows: 5, spacing: 1.6,
        )],
    ),
    torches: [(
        position: (1.5, 2.2, 1.5), colour: (1.0, 0.52, 0.18), intensity: 24.0, range: 8.0,
    )],
    set_pieces: [(
        name: "reveal_horde",
        cues: [(
            at: 0,
            action: LightPulse((
                toward_source: (-0.5, 1.0, 0.3), colour: (0.55, 0.7, 1.0),
                intensity: 2.0, fill: 0.12, duration_ticks: 15,
            )),
        )],
    )],
)
