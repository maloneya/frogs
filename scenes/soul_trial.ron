// Can attacks from all directions stay readable as enemies emerge into one light?
// Press E by the blue switch, aim with the cursor, and attack with Space/left click.
// Defeat 30 in 30 seconds to unlock the chest; press E beside it to open its lid.
// Eight sources sit 9 m from the centre, outside the light's 8 m range even
// with their 0.5 m spawn radius. Every 144 ticks per source preserves the old
// aggregate rate (8/144 = 1/18), now arriving in eight-enemy waves.
(
    engine: (
        name: "Soul trial - circle in the dark",
        bodies: [
            (pos: (1.2, 0.0), what: (fixed: true, interactable: true)), // switch 0
            (pos: (0.0, 2.5), what: (fixed: true)), // chest 1
        ],
        sources: [
            (pos: (0.0, 9.0), radius: 0.5, every: 144, what: (seeks: true), enabled: false),
            (pos: (6.364, 6.364), radius: 0.5, every: 144, what: (seeks: true), enabled: false),
            (pos: (9.0, 0.0), radius: 0.5, every: 144, what: (seeks: true), enabled: false),
            (pos: (6.364, -6.364), radius: 0.5, every: 144, what: (seeks: true), enabled: false),
            (pos: (0.0, -9.0), radius: 0.5, every: 144, what: (seeks: true), enabled: false),
            (pos: (-6.364, -6.364), radius: 0.5, every: 144, what: (seeks: true), enabled: false),
            (pos: (-9.0, 0.0), radius: 0.5, every: 144, what: (seeks: true), enabled: false),
            (pos: (-6.364, 6.364), radius: 0.5, every: 144, what: (seeks: true), enabled: false),
        ],
    ),
    chests: [(body: 1)],
    encounters: [(
        name: "Soul trial",
        start: Activated(0),
        objective: Defeat((sources: [0,1,2,3,4,5,6,7], count: 30, within_ticks: 1800)),
        on_success: [UnlockChest(0)],
    )],
    torches: [
        (position: (0.0, 2.2, 0.0), colour: (1.0, 0.65, 0.3), intensity: 55.0, range: 8.0),
    ],
)
