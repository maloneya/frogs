        torches: [],
        trees: [],
        doors: [],
        chests: [],
        encounters: [],
    ),
    labels: [
        (
            target: (
                kind: source,
                index: 0,
            ),
            name: "West spawner",
        ),
        (
            target: (
                kind: source,
                index: 1,
            ),
            name: "South spawner",
        ),
        (
