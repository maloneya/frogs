// Kite enemies arriving from three directions and compare crowd control.
// Each source emits once per second, up to sixty enemies across the scene.
(
    scene: (
        environment: (
            storm: false,
            ambient_colour: (1.0, 1.0, 1.0),
            ambient_intensity: 0.22,
            directional_colour: (1.0, 1.0, 1.0),
            directional_intensity: 0.35,
            direction: (0.4, 1.0, 0.3),
        ),
        engine: (
            name: "Three enemy spawners",
            bodies: [],
            grids: [],
            sources: [
                (
                    enabled: true,
                    pos: (-9.0, 8.0),
                    radius: 1.5,
                    every: 60,
                    when: FewerThan(60),
                    what: (
                        physical: (
                            fixed: false,
                            mass: 1.0,
                            interactable: false,
                            health: Some(3),
                            character: true,
                        ),
                        role: Hostile,
                        actions: [
                            Move((
                                destination: Target(Player),
                                speed: 2.5,
                                acceleration: 30.0,
                                stop_distance: 0.55,
                            )),
                        ],
                        behavior: Action(0),
                    ),
                ),
                (
                    enabled: true,
                    pos: (0.0, -11.0),
                    radius: 1.5,
                    every: 60,
                    when: FewerThan(60),
                    what: (
                        physical: (
                            fixed: false,
                            mass: 1.0,
                            interactable: false,
                            health: Some(3),
                            character: true,
                        ),
                        role: Hostile,
                        actions: [
                            Move((
                                destination: Target(Player),
                                speed: 2.5,
                                acceleration: 30.0,
                                stop_distance: 0.55,
                            )),
                        ],
                        behavior: Action(0),
                    ),
                ),
                (
                    enabled: true,
                    pos: (9.0, 8.0),
                    radius: 1.5,
                    every: 60,
                    when: FewerThan(60),
                    what: (
                        physical: (
                            fixed: false,
                            mass: 1.0,
                            interactable: false,
                            health: Some(3),
                            character: true,
                        ),
                        role: Hostile,
                        actions: [
                            Move((
                                destination: Target(Player),
                                speed: 2.5,
                                acceleration: 30.0,
                                stop_distance: 0.55,
                            )),
                        ],
                        behavior: Action(0),
                    ),
                ),
            ],
            walls: [],
