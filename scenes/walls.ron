// Can the player slide along flat and rotated walls, and attack only exposed enemies?
// Walk toward the long wall, try Space/2/3, then walk around its right end.
// The nearest enemy is shielded; the enemy beside the opening can be attacked.
(
    engine: (
        name: "Walls — movement and attack cover",
        walls: [
            (centre: (0.0, 2.0), size: (6.0, 0.4)),
            (centre: (-3.0, 5.0), size: (0.4, 6.0)),
            (centre: (5.5, 5.0), size: (4.0, 0.3), yaw: 0.7853982),
        ],
        bodies: [
            (pos: (0.0, 2.6)),
            (pos: (4.0, 2.6)),
            (pos: (-1.5, 4.0), what: (seeks: true)),
        ],
    ),
    torches: [(position: (0.0, 3.0, 1.0), colour: (1.0, 0.8, 0.6), intensity: 100.0, range: 16.0)],
)
